--==================================================
-- DRAG MENU
--==================================================

local menuDragging = false
local menuStart
local menuPosition

DragBar.InputBegan:Connect(function(input)

	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	menuDragging = true
	menuStart = input.Position
	menuPosition = Menu.Position

end)

--==================================================
-- INPUT MOVE
--==================================================

UIS.InputChanged:Connect(function(input)

	-- MENU
	if menuDragging then

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - menuStart

			local x = menuPosition.X.Offset + delta.X
			local y = menuPosition.Y.Offset + delta.Y

			local camera = Workspace.CurrentCamera

			if camera then

				local viewport = camera.ViewportSize

				x = math.clamp(
					x,
					0,
					math.max(0,viewport.X - Menu.AbsoluteSize.X)
				)

				y = math.clamp(
					y,
					0,
					math.max(0,viewport.Y - Menu.AbsoluteSize.Y)
				)

			end

			Menu.Position = UDim2.fromOffset(x,y)

		end

	end

	-- LOGO
	if logoDragging then

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - logoStart

			if math.abs(delta.X) > 5
				or math.abs(delta.Y) > 5 then

				logoMoved = true

			end

			local x = logoPosition.X.Offset + delta.X
			local y = logoPosition.Y.Offset + delta.Y

			local camera = Workspace.CurrentCamera

			if camera then

				local viewport = camera.ViewportSize
				local padding = 8

				x = math.clamp(
					x,
					padding,
					math.max(
						padding,
						viewport.X - Toggle.AbsoluteSize.X - padding
					)
				)

				y = math.clamp(
					y,
					padding,
					math.max(
						padding,
						viewport.Y - Toggle.AbsoluteSize.Y - padding
					)
				)

			end

			Toggle.Position = UDim2.fromOffset(x,y)

		end

	end

end)

--==================================================
-- INPUT END
--==================================================

UIS.InputEnded:Connect(function(input)

	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if menuDragging then
		menuDragging = false
	end

	if logoDragging then

		logoDragging = false

		-- Chỉ mở menu nếu không kéo logo
		if not logoMoved then
			Menu.Visible = not Menu.Visible
		end

	end

end)

