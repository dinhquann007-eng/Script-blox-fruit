--==================================================
-- NPC FILTER
--==================================================

local function IsQuestNPC(obj)
	local model

	if obj:IsA("Model") then
		model = obj
	else
		model = obj:FindFirstAncestorOfClass("Model")
	end

	if not model then
		return false
	end

	local name = string.lower(model.Name)

	local words = {
		"quest",
		"questgiver",
		"quest_giver",
		"quest giver",
		"questnpc",
		"quest npc",
		"shopkeeper",
		"dealer",
		"merchant"
	}

	for _,word in ipairs(words) do
		if string.find(name,word,1,true) then
			return true
		end
	end

	return false
end

--==================================================
-- FX TYPE
--==================================================

local function IsFX(obj)
	return obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight")
		or obj:IsA("Highlight")
		or obj:IsA("Fire")
		or obj:IsA("Smoke")
		or obj:IsA("Sparkles")
end

--==================================================
-- APPLY COLOR
--==================================================

local function ApplyColor(obj)

	if not Enabled then return end
	if not obj or not obj.Parent then return end
	if not IsFX(obj) then return end
	if IsQuestNPC(obj) then return end

	pcall(function()

		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam") then

			obj.Color = ColorSequence.new(CurrentColor)

		elseif obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			obj.Color = CurrentColor

		elseif obj:IsA("Highlight") then

			obj.FillColor = CurrentColor
			obj.OutlineColor = CurrentColor

		elseif obj:IsA("Fire") then

			obj.Color = CurrentColor
			obj.SecondaryColor = CurrentColor

		elseif obj:IsA("Smoke") then

			obj.Color = CurrentColor

		elseif obj:IsA("Sparkles") then

			obj.SparkleColor = CurrentColor

		end

	end)
end

--==================================================
-- TRACK FX
--==================================================

local TrackedFX = {}
local ConnectedContainers = {}

local function TrackFX(obj)

	if not obj then return end

	if ConnectedContainers[obj] then
		return
	end

	ConnectedContainers[obj] = true

	for _,v in ipairs(obj:GetDescendants()) do
		if IsFX(v) then
			TrackedFX[v] = true
			ApplyColor(v)
		end
	end

	obj.DescendantAdded:Connect(function(v)

		if IsFX(v) then
			TrackedFX[v] = true
			ApplyColor(v)

			task.defer(function()
				if v and v.Parent then
					ApplyColor(v)
				end
			end)
		end

	end)
end

--==================================================
-- CHARACTER
--==================================================

local function SetupCharacter(character)

	if not character then return end

	TrackFX(character)

	for _,child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			TrackFX(child)
		end
	end

	character.ChildAdded:Connect(function(child)

		if child:IsA("Tool") then
			TrackFX(child)
		end

	end)
end

