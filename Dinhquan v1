local counter = 0

RunService.Heartbeat:Connect(function()

	if not Enabled then return end

	counter += 1

	if counter < 3 then
		return
	end

	counter = 0

	for obj in pairs(TrackedFX) do

		if not obj or not obj.Parent then

			TrackedFX[obj] = nil

		elseif IsFX(obj) then

			ApplyColor(obj)

		else

			TrackedFX[obj] = nil

		end

	end

end)

